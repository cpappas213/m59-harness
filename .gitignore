# The client's own art: 5,355 PNGs decoded from its .bgf files, 40 MB of it, and
# not ours to redistribute. Regenerate from any local client with
#     python tools/pull-client-assets.py
/compendium/assets/img/

node_modules/

# Everything a running fleet writes. This repository is a starting point, not a
# snapshot of somebody's characters: the roster carries account passwords in
# plain text, and the flight recordings are one server's history, not reference.
/substrate/fleet-state.json
/substrate/fleet-state.json.*
# Named fleets (--fleet <name>) keep a roster each under here. Same plaintext
# passwords as the file above, one file per server, so the whole directory goes —
# a rule naming only fleet-state.json stops covering the roster the moment anyone
# runs the very feature that directory exists for.
/substrate/fleets/
/substrate/history/
/substrate/recordings/
# One JSON per death. Carries the last thirty lines the server sent that character,
# which is other players' speech as well as combat text, so it is one server's
# transcript and not reference material.
/substrate/postmortems/
# One JSON per character: how good it is at each skill and spell, and every change
# since it was first read. One server's characters, and the history is theirs — the
# same reason the roster and the post-mortems are not here.
/substrate/abilities/
/substrate/*.log
# Which process m59-service.mjs last started, per fleet. Runtime state, and wrong the
# moment it is read on any other machine.
/substrate/*.pid
# Which fleet THIS checkout means when nothing says otherwise (see m59-fleetpath.mjs).
# No secret in it — one name — but it is one machine's answer, and committing it would
# point a stranger's tools at a roster they do not have.
/substrate/fleet-default
/commissions/

# The account passwords for a fleet made by tools/m59-makefleet.mjs. This is the
# ONLY copy of them — back it up if you care about the characters, but never
# commit it.
/substrate/fleet-accounts.json

# The click-to-play shortcuts written by tools/m59-shortcuts.mjs. The client has
# no way to be handed a password except on its command line, so each of these is
# one account's credentials in plain text — as secret as the file above, and
# regenerated in a second by `node tools/setup.mjs shortcuts`.
/shortcuts/

# The server container's state: the world, the accounts, and the channel logs,
# which are real player chat. Delete to start the server over.
/docker/data/

# Transient logs from background helpers and test sweeps. Each is a record of one
# run against one server state, so none of it is worth carrying forward.
.m59-*.log
.build-m59.log

# The Meridian 59 client writes these into whatever directory it is launched from
/meridian.ini
/config.ini
/d3dlog.txt
/mail/
/ads/
/download/
/help/
/resource/

# Personal Claude Code settings — the status line points at a broker port that is
# a local choice, not a shared one.
.claude/settings.local.json

__pycache__/
*.pyc
/substrate/keeper-uptime.jsonl
